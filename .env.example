# --- dd-cons-shell env ---
# Generate the secret with: openssl rand -hex 32
SHELL_BETTER_AUTH_SECRET=replace-me-with-at-least-32-hex-chars

# Public base URL the shell serves from.
# Production: https://<umbrella-domain> (the cookie apex is derived from it)
# Local dev:  http://localhost:3000
SHELL_BETTER_AUTH_URL=http://localhost:3000

# Cookie domain. Production should be ".<umbrella-domain>" so the session
# cookie is readable by dev-division + consulting-agency sub-paths. Defaults
# to the apex of SHELL_BETTER_AUTH_URL; leave unset in dev so better-auth
# falls back to host-only on localhost.
SHELL_COOKIE_DOMAIN=

# Only during a domain migration: previous cookie apex whose stale copies the
# middleware should expire. Unset = no legacy clearing.
SHELL_LEGACY_COOKIE_DOMAIN=

# GitHub OAuth (https://github.com/settings/developers)
SHELL_GITHUB_CLIENT_ID=
SHELL_GITHUB_CLIENT_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
SHELL_GOOGLE_CLIENT_ID=
SHELL_GOOGLE_CLIENT_SECRET=
